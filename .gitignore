# ---------------------------------------------------------------------------
# Python bytecode / caches
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# ---------------------------------------------------------------------------
# Packaging / build artifacts
# ---------------------------------------------------------------------------
# src/sollabdata.egg-info/ is regenerated by every `pip install -e .`, so it is
# noise in the history rather than something to track.
build/
dist/
sdist/
wheels/
*.egg-info/
*.egg
.eggs/
MANIFEST
pip-wheel-metadata/

# ---------------------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------------------
# The project is normally used from the `dev_venv` conda env rather than a local
# venv, but ignore the usual names in case one gets created here.
.venv/
venv/
env/
ENV/
.conda/
.python-version

# ---------------------------------------------------------------------------
# Jupyter / IPython
# ---------------------------------------------------------------------------
# Notebooks are where this package actually gets used, so the checkpoint copies
# Jupyter leaves behind would otherwise show up constantly.
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# ---------------------------------------------------------------------------
# Test / type-check / lint caches
# ---------------------------------------------------------------------------
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# ---------------------------------------------------------------------------
# Editors and OS cruft
# ---------------------------------------------------------------------------
# .vscode/settings.json is tracked on purpose (it pins the conda env for the
# Python extension), so ignore the rest of the folder but keep that one file.
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Lab data
# ---------------------------------------------------------------------------
# Raw instrument exports and anything LabData.write() produces live outside the
# repo. Uncomment / adjust if you ever keep a scratch data folder in the tree --
# deliberately NOT ignoring *.csv globally, since small csv files are useful as
# test fixtures under tests/.
# data/
# raw_data/
# processed_data/
*.h5
*.hdf5

# ---------------------------------------------------------------------------
# Written by RG (Robert Gipson). Created by Claude (Opus 5): standard Python
# ignores (bytecode, build/egg-info artifacts, venvs, notebook checkpoints, test
# and lint caches, editor/OS files) plus a .vscode negation that keeps the
# tracked settings.json, and a commented-out lab-data section.
# ---------------------------------------------------------------------------
